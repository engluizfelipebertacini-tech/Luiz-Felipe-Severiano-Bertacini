rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'eng.luizfelipebertacini@gmail.com';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasAnyRole() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    function isAdminOrSocio() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (getUserData().role == 'admin' || getUserData().role == 'socio'))
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isBootstrappedAdmin() || (isSignedIn() && request.auth.uid == userId) || isAdminOrSocio();
    }

    // Company Settings
    match /company_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrSocio();
    }

    // Clients
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrSocio();
    }

    // Opportunities (CRM)
    match /opportunities/{opportunityId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrSocio();
    }

    // Proposals
    match /proposals/{proposalId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrSocio();
    }

    // Services
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrSocio();
    }

    // Inspections
    match /inspections/{inspectionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrSocio();
    }

    // Expert Cases (Perícias)
    match /expert_cases/{caseId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrSocio();
    }

    // Technical Documents
    match /technical_documents/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrSocio();
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Calendar Events
    match /calendar_events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Financial Entries
    match /financial_entries/{entryId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrSocio();
    }

    // Activity Logs
    match /activity_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
